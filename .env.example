# Anti-Cocoon Engine · 环境变量（全部可选，不设也能开箱即用）

# 服务端口（默认 8787）
# PORT=8787
# HOST=127.0.0.1

# ---- 可选：真实全网搜索（SearXNG）----
# 设置后，搜索源自动从"精选库"切换到 SearXNG 实时结果。
# 需要你自己跑一个 SearXNG 实例（见 https://docs.searxng.org/）。
# SEARXNG_URL=http://127.0.0.1:8080
# SEARXNG_LANGUAGE=zh-CN
# SEARXNG_TIMEOUT=8000

# 说明：
# - A.G.E.N.T. 引擎与自然语言反馈解析，在页面右上角"连接模型"里配置，
#   API Key 仅存内存、不落盘，无需写在这里。
